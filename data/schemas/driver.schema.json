{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "driver",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "nameKey",
    "descKey",
    "perks"
  ],
  "properties": {
    "id": {
      "$ref": "common#/definitions/id"
    },
    "nameKey": {
      "$ref": "common#/definitions/key"
    },
    "descKey": {
      "$ref": "common#/definitions/key"
    },
    "perks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "enum": [
                  "fuelMult",
                  "escapeMult"
                ]
              },
              "value": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "const": "evasionBonus"
              },
              "value": {
                "$ref": "common#/definitions/probability"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "slot",
              "item"
            ],
            "properties": {
              "type": {
                "const": "startEquipment"
              },
              "slot": {
                "type": "string"
              },
              "item": {
                "$ref": "common#/definitions/id"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "delta"
            ],
            "properties": {
              "type": {
                "const": "startResources"
              },
              "delta": {
                "$ref": "common#/definitions/resources"
              }
            }
          }
        ]
      }
    }
  }
}
