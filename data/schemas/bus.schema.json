{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "bus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "nameKey",
    "rows",
    "cols",
    "exposedCols",
    "seats",
    "slots",
    "startEquipment",
    "tankDurability",
    "hull",
    "systems"
  ],
  "properties": {
    "id": {
      "$ref": "common#/definitions/id"
    },
    "nameKey": {
      "$ref": "common#/definitions/key"
    },
    "rows": {
      "type": "integer",
      "minimum": 1
    },
    "cols": {
      "type": "integer",
      "minimum": 1
    },
    "exposedCols": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "seats": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "row",
          "col",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^r[0-9]+c[0-9]+$"
          },
          "row": {
            "type": "integer",
            "minimum": 0
          },
          "col": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "enum": [
              "driver",
              "navigator",
              "weapon",
              "mechanic",
              "medic",
              "plain"
            ]
          },
          "slot": {
            "type": "string"
          }
        }
      }
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
          },
          "kind": {
            "$ref": "common#/definitions/slotKind"
          },
          "covers": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "startEquipment": {
      "type": "object",
      "additionalProperties": {
        "$ref": "common#/definitions/id"
      }
    },
    "tankDurability": {
      "type": "integer",
      "minimum": 1
    },
    "hull": {
      "type": "integer",
      "minimum": 1
    },
    "systems": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "wheels",
        "cabin"
      ],
      "properties": {
        "engine": {
          "type": "integer",
          "minimum": 1
        },
        "wheels": {
          "type": "integer",
          "minimum": 1
        },
        "cabin": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
