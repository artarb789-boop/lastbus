{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "enemy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "nameKey",
    "kind",
    "tier",
    "weight",
    "hull",
    "systems",
    "evasion",
    "speed",
    "armor",
    "weapons",
    "ai",
    "preferredRange",
    "loot"
  ],
  "properties": {
    "id": {
      "$ref": "common#/definitions/id"
    },
    "nameKey": {
      "$ref": "common#/definitions/key"
    },
    "kind": {
      "enum": [
        "raider",
        "rival",
        "boss"
      ]
    },
    "tier": {
      "type": "integer",
      "minimum": 1
    },
    "weight": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "hull": {
      "type": "integer",
      "minimum": 1
    },
    "systems": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "wheels",
        "cabin",
        "tank"
      ],
      "properties": {
        "engine": {
          "type": "integer",
          "minimum": 1
        },
        "wheels": {
          "type": "integer",
          "minimum": 1
        },
        "cabin": {
          "type": "integer",
          "minimum": 1
        },
        "tank": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "evasion": {
      "$ref": "common#/definitions/probability"
    },
    "speed": {
      "type": "number",
      "minimum": 0
    },
    "armor": {
      "type": "integer",
      "minimum": 0
    },
    "weapons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common#/definitions/id"
      }
    },
    "ai": {
      "$ref": "common#/definitions/aiProfile"
    },
    "preferredRange": {
      "$ref": "common#/definitions/rangeBand"
    },
    "fleeAtHull": {
      "$ref": "common#/definitions/probability"
    },
    "surrenderAtHull": {
      "$ref": "common#/definitions/probability"
    },
    "loot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resources",
        "survivors"
      ],
      "properties": {
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fuel": {
              "$ref": "common#/definitions/range"
            },
            "food": {
              "$ref": "common#/definitions/range"
            },
            "parts": {
              "$ref": "common#/definitions/range"
            },
            "ammo": {
              "$ref": "common#/definitions/range"
            },
            "medkits": {
              "$ref": "common#/definitions/range"
            },
            "tokens": {
              "$ref": "common#/definitions/range"
            }
          }
        },
        "survivors": {
          "$ref": "common#/definitions/range"
        }
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "atHull",
          "effects"
        ],
        "properties": {
          "atHull": {
            "$ref": "common#/definitions/probability"
          },
          "effects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "count"
                  ],
                  "properties": {
                    "type": {
                      "const": "disableWeapons"
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "ai"
                  ],
                  "properties": {
                    "type": {
                      "const": "setAi"
                    },
                    "ai": {
                      "$ref": "common#/definitions/aiProfile"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "range"
                  ],
                  "properties": {
                    "type": {
                      "const": "setPreferredRange"
                    },
                    "range": {
                      "$ref": "common#/definitions/rangeBand"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
